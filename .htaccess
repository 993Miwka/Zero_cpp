# MobileWeb - Apache Configuration
# Optimized for mobile devices and performance

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Remove trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]
    
    # Redirect to canonical URL
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE font/truetype font/opentype font/eot font/woff font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Cache fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType font/eot "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    
    # Cache images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    
    # Cache CSS and JS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Cache HTML
    ExpiresByType text/html "access plus 1 day"
</IfModule>

# Enable Gzip compression
<IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Content Type Options
    Header set X-Content-Type-Options "nosniff"
    
    # X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    
    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://*.unsplash.com; connect-src 'self' https://fonts.googleapis.com; frame-src 'self' https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
    
    # Strict Transport Security
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# Mobile Optimization
<IfModule mod_mime.c>
    # Enable Keep-Alive
    KeepAlive On
    MaxKeepAliveRequests 100
    KeepAliveTimeout 5
    
    # Mobile device detection
    BrowserMatchNoCase "Android" forcedown
    BrowserMatchNoCase "BlackBerry" forcedown
    BrowserMatchNoCase "iPhone" forcedown
    BrowserMatchNoCase "iPad" forcedown
    BrowserMatchNoCase "iPod" forcedown
    BrowserMatchNoCase "Opera Mini" forcedown
    BrowserMatchNoCase "IEMobile" forcedown
    BrowserMatchNoCase "Windows Phone" forcedown
</IfModule>

# Custom Error Pages
ErrorDocument 400 /pages/offline.html
ErrorDocument 401 /pages/offline.html
ErrorDocument 403 /pages/offline.html
ErrorDocument 404 /pages/offline.html
ErrorDocument 500 /pages/offline.html

# Directory Index
DirectoryIndex index.html

# Disable directory listing
Options -Indexes

# Disable .htaccess access
<Files ".htaccess">
    Order allow,deny
    Deny from all
</Files>

# Disable access to sensitive files
<FilesMatch "\.(env|json|log|sql|md|txt|xml|ini|conf|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow access to specific JSON files
<FilesMatch "^(manifest\.json|Zero_.*\.json)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Compress JSON responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Set JSON content type
<IfModule mod_mime.c>
    AddType application/json .json
</IfModule>

# Enable CORS for fonts
<IfModule mod_headers.c>
    <FilesMatch "\.(woff|woff2|ttf|eot|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
